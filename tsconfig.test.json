{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "./dist-test",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": [
    "src/components/spreader/core/find-replace-core.ts",
    "src/components/spreader/core/border-pool.ts",
    "src/components/spreader/core/border-resolve.ts",
    "src/components/spreader/core/style-pool.ts",
    "src/components/spreader/core/number-format.ts",
    "src/components/spreader/core/sort-core.ts",
    "src/components/spreader/core/autofill.ts",
    "src/components/spreader/core/formula.ts",
    "src/components/spreader/core/types.ts",
    "src/components/spreader/core/utils.ts",
    "src/components/spreader/core/constants.ts",
    "src/components/spreader/core/data-validation.ts",
    "test/**/*.ts"
  ]
}
