{
  "name": "xiaodao-spreader",
  "version": "0.1.19",
  "description": "A Vue 3 component for spreading sheets",
  "type": "module",
  "license": "MIT",
  "homepage": "https://xiaodaozhi.com/xiaodao-spreader.html",
  "keywords": [
    "vue",
    "canvas",
    "spreader",
    "sheet"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/xiaodao-spreader.umd.js",
  "module": "./dist/xiaodao-spreader.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/xiaodao-spreader.es.js",
      "require": "./dist/xiaodao-spreader.umd.js"
    }
  },
  "sideEffects": ["*.vue", "*.css"],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vue-tsc -p tsconfig.build.json",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node -e \"require('fs').writeFileSync('dist-test/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && node --test dist-test/test/find-replace-core.test.js",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@types/node": "^20.0.0",
    "typescript": "~5.4.0",
    "vite": "^5.0.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.2.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaodaozhi/xiaodao-spreader.git"
  }
}
